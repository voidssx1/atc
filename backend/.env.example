# ==============================================================================
# ATC DSA Roadmap & Resource Hub Backend — Environment Configuration Template
# ==============================================================================
# Copy to `.env` for local development. NEVER commit real secrets or `.env`.
# In production (Cloudflare Workers), non-secret vars live in `wrangler.toml`
# and sensitive credentials are uploaded via `wrangler secret put <NAME>`.

# ------------------------------------------------------------------------------
# Core Application & Runtime Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="ATC DSA Roadmap & Resource Hub"
API_V1_STR=/api/v1
CLOUDFLARE_ORIGIN_URL=https://atc-dsa-final-api.YOUR_WORKERS_SUBDOMAIN.workers.dev

# ------------------------------------------------------------------------------
# Database (Neon PostgreSQL / Cloudflare Hyperdrive)
# ------------------------------------------------------------------------------
# Direct Neon connection string (used for Alembic migrations & local dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/atc_hub
# Optional pooled Neon URL and Hyperdrive runtime fallback
DATABASE_URL_POOLED=
HYPERDRIVE_DATABASE_URL=
# Optional local Wrangler dev override for [[hyperdrive]] binding "HYPERDRIVE":
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/atc_hub

# ------------------------------------------------------------------------------
# Authentication, Sessions & Access Policies
# ------------------------------------------------------------------------------
# Options: "clerk" (production default), "hybrid", "legacy"
AUTH_MODE=hybrid
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
STUDENT_ALLOWED_EMAIL_DOMAIN=bennett.edu.in
PBKDF2_ITERATIONS=600000

SESSION_MAX_LIFETIME_DAYS=30
SESSION_INACTIVITY_DAYS=7
SESSION_ADMIN_INACTIVITY_MINUTES=30
SESSION_ROTATION_GRACE_SECONDS=30
SESSION_EXPIRE_DAYS=30

# Comma-separated exact frontend origins allowed for browser CORS (no trailing '/')
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Clerk Identity & Webhook Verification
# ------------------------------------------------------------------------------
# In production (ENVIRONMENT=production & AUTH_MODE=clerk), all non-placeholder
# Clerk settings below are strictly validated on every HTTP Worker request.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_CLERK_WEBHOOK_SECRET
CLERK_ISSUER=https://YOUR_CLERK_ISSUER
CLERK_JWKS_URL=https://YOUR_CLERK_ISSUER/.well-known/jwks.json
# Optional PEM public key alternative to JWKS discovery (escape newlines as \n)
CLERK_JWT_KEY=
# Comma-separated exact frontend origins validated against JWT `azp` claim
CLERK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Transactional Email Providers (Resend Primary + Brevo Fallback)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY
BREVO_API_KEY=xkeysib_REPLACE_WITH_BREVO_API_KEY
EMAILS_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER_EMAIL
EMAILS_FROM_NAME="ATC DSA Roadmap Hub"

# Optional fallback SMTP fields defined in Settings (not used by HTTP Workers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
